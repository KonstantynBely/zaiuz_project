[Unit]
Description=RoverSense Database Migrations
Requires=postgresql@17-main.service
After=postgresql@17-main.service

[Service]
Type=oneshot
User=roversense
Group=roversense

WorkingDirectory=/srv/roversense/current/backend
EnvironmentFile=/etc/roversense/backend.env
ExecStart=/usr/bin/node dist/database/migrate.js

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
UMask=0027
