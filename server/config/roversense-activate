#!/usr/bin/env bash
# Aktywacja wcześniej przygotowanego wydania przez konto uprawnione w sudoers.
# Argument: pełne 40-znakowe SHA; źródło: incoming/<SHA> albo istniejące releases/<SHA>.
# Skutki: przeniesienie plików, zmiana current, migracje, restart i kontrola HTTP.
# Kod 0 oznacza potwierdzony healthcheck; błąd uruchamia dostępne przywrócenie kodu.
# Skrypt nie cofa migracji ani zmian danych i nie służy do lokalnego testowania aplikacji.
set -euo pipefail

if [[ $EUID -ne 0 || $# -ne 1 || ! $1 =~ ^[0-9a-f]{40}$ ]]; then
  echo 'Uzycie: roversense-activate <40-znakowy SHA>' >&2
  exit 2
fi

base=/srv/roversense
incoming="$base/incoming/$1"
release="$base/releases/$1"
current="$base/current"
next="$base/.current-next"

exec 9>/run/lock/roversense-deploy.lock
flock -n 9 || {
  echo 'Inne wdrozenie jest w toku.' >&2
  exit 1
}

if [[ ! -e "$release" && ! -L "$release" ]]; then
  if [[ ! -d "$incoming" || -L "$incoming" ||
        "$(realpath -e "$incoming")" != "$incoming" ]]; then
    echo 'Brak poprawnego katalogu incoming.' >&2
    exit 1
  fi

  if [[ "$(stat -c %U "$incoming")" != roversense-deploy ]]; then
    echo 'Niepoprawny wlasciciel incoming.' >&2
    exit 1
  fi

  pending=$(mktemp -d "$base/releases/.pending.XXXXXXXX")
  trap 'rm -rf -- "$pending"' EXIT

  cp -a -- "$incoming/." "$pending/"

  for file in \
    backend/dist/server.js \
    backend/dist/database/migrate.js \
    backend/node_modules/pg/package.json \
    frontend/dist/index.html \
    database/migrations/001_initial.sql; do
    if [[ ! -f "$pending/$file" ]]; then
      echo "Brak pliku wydania: $file" >&2
      exit 1
    fi
  done

  chown -R root:root "$pending"
  chmod -R u=rwX,go=rX "$pending"

  mv -T -- "$pending" "$release"
  trap - EXIT
  rm -rf -- "$incoming"
fi

if [[ ! -d "$release" || -L "$release" ||
      "$(realpath -e "$release")" != "$release" ||
      "$(stat -c %U "$release")" != root ]]; then
  echo 'Niepoprawny katalog wydania.' >&2
  exit 1
fi

for file in \
  backend/dist/server.js \
  backend/dist/database/migrate.js \
  backend/node_modules/pg/package.json \
  frontend/dist/index.html \
  database/migrations/001_initial.sql; do
  if [[ ! -f "$release/$file" ]]; then
    echo "Brak pliku wydania: $file" >&2
    exit 1
  fi
done

if [[ -e $current && ! -L $current ]]; then
  echo 'current nie jest dowiazaniem symbolicznym.' >&2
  exit 1
fi

if [[ -e $next || -L $next ]]; then
  echo 'Pozostalo tymczasowe dowiazanie .current-next.' >&2
  exit 1
fi

previous=''
if [[ -L $current ]]; then
  previous="$(readlink "$current")"
fi

restore_previous() {
  # Przywróć poprzedni cel current przez atomową podmianę dowiązania.
  # Korzysta z globalnych previous/next/current; przy pierwszym wdrożeniu usuwa current.
  # Ta funkcja nie restartuje usługi ani nie przywraca poprzedniego schematu bazy.
  if [[ -n $previous ]]; then
    ln -s "$previous" "$next"
    mv -Tf "$next" "$current"
  else
    rm -f "$current"
  fi
}

ln -s "$release" "$next"
mv -Tf "$next" "$current"

if ! systemctl start roversense-migrate.service; then
  echo 'Blad migracji. Przywracanie poprzedniej wersji.' >&2
  restore_previous
  exit 1
fi

if ! systemctl restart roversense.service; then
  echo 'Blad uruchamiania backendu.' >&2
  restore_previous
  if [[ -n $previous ]]; then
    systemctl restart roversense.service || true
  fi
  exit 1
fi

for i in {1..15}; do
  if curl -fsS --max-time 3 \
    http://127.0.0.1:3000/api/health 2>/dev/null \
    | grep -Fq '"status":"ok"'; then
    systemctl enable roversense.service
    echo "Wdrozenie aktywne: $1"
    exit 0
  fi
  sleep 1
done

echo 'API nie odpowiada. Przywracanie poprzedniej wersji.' >&2
restore_previous

if [[ -n $previous ]]; then
  systemctl restart roversense.service || true
else
  systemctl stop roversense.service || true
fi

exit 1
