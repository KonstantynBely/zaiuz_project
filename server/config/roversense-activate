#!/usr/bin/env bash
set -euo pipefail

if [[ $EUID -ne 0 || $# -ne 1 || ! $1 =~ ^[0-9a-f]{40}$ ]]; then
  echo 'Uzycie: roversense-activate <40-znakowy SHA>' >&2
  exit 2
fi

base=/srv/roversense
release="$base/releases/$1"
current="$base/current"
next="$base/.current-next"

exec 9>/run/lock/roversense-deploy.lock
flock -n 9 || {
  echo 'Inne wdrozenie jest w toku.' >&2
  exit 1
}

if [[ ! -d $release || -L $release || "$(realpath -e "$release")" != "$release" ]]; then
  echo 'Niepoprawny katalog wydania.' >&2
  exit 1
fi

for file in \
  backend/dist/server.js \
  backend/dist/database/migrate.js \
  backend/node_modules/pg/package.json \
  frontend/dist/index.html \
  database/migrations/001_initial.sql; do
  if [[ ! -f "$release/$file" ]]; then
    echo "Brak pliku wydania: $file" >&2
    exit 1
  fi
done

if [[ -e $current && ! -L $current ]]; then
  echo 'current nie jest dowiazaniem symbolicznym.' >&2
  exit 1
fi

if [[ -e $next || -L $next ]]; then
  echo 'Pozostalo tymczasowe dowiazanie .current-next.' >&2
  exit 1
fi

previous=''
if [[ -L $current ]]; then
  previous="$(readlink "$current")"
fi

restore_previous() {
  if [[ -n $previous ]]; then
    ln -s "$previous" "$next"
    mv -Tf "$next" "$current"
  else
    rm -f "$current"
  fi
}

ln -s "$release" "$next"
mv -Tf "$next" "$current"

if ! systemctl start roversense-migrate.service; then
  echo 'Blad migracji. Przywracanie poprzedniej wersji.' >&2
  restore_previous
  exit 1
fi

if ! systemctl restart roversense.service; then
  echo 'Blad uruchamiania backendu.' >&2
  restore_previous
  if [[ -n $previous ]]; then
    systemctl restart roversense.service || true
  fi
  exit 1
fi

for i in {1..15}; do
  if curl -fsS --max-time 3 \
    http://127.0.0.1:3000/api/health 2>/dev/null \
    | grep -Fq '"status":"ok"'; then
    systemctl enable roversense.service
    echo "Wdrozenie aktywne: $1"
    exit 0
  fi
  sleep 1
done

echo 'API nie odpowiada. Przywracanie poprzedniej wersji.' >&2
restore_previous

if [[ -n $previous ]]; then
  systemctl restart roversense.service || true
else
  systemctl stop roversense.service || true
fi

exit 1
