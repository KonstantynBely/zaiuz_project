[Unit]
Description=RoverSense - PostgreSQL Backup
Requires=postgresql@17-main.service
After=postgresql@17-main.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/local/sbin/roversense-backup

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/roversense/postgresql
