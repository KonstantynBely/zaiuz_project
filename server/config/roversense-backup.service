[Unit]
Description=RoverSense - kopia PostgreSQL / TimescaleDB
Requires=postgresql@17-main.service
After=postgresql@17-main.service

[Service]
Type=oneshot
User=postgres
Group=postgres
UMask=0077
ExecStart=/usr/local/libexec/roversense-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/roversense/postgresql
