#!/usr/bin/env bash
set -euo pipefail
umask 077

# Odtwarza kopię do bazy TESTOWEJ; nie modyfikuje bazy produkcyjnej.
if [[ "$(id -un)" != postgres ]]; then
  echo 'Test odtwarzania musi być uruchomiony jako postgres.' >&2
  exit 1
fi
if (( $# > 1 )); then
  echo 'Użycie: roversense-restore-check [katalog kopii]' >&2
  exit 2
fi

backup_root=/var/backups/roversense/postgresql
if (( $# == 1 )); then
  backup_dir=$1
else
  latest=$(find "$backup_root" -mindepth 1 -maxdepth 1 -type d \
    -name 'backup-20??????T??????Z-*' -printf '%f\n' | LC_ALL=C sort | tail -n1)
  if [[ -z "$latest" ]]; then
    echo 'Brak kopii do przetestowania.' >&2
    exit 1
  fi
  backup_dir="$backup_root/$latest"
fi

if [[ ! -d "$backup_dir" || ! -f "$backup_dir/roversense.dump" || ! -f "$backup_dir/SHA256SUMS" ]]; then
  echo 'Kopia nie zawiera wymaganego archiwum lub sum kontrolnych.' >&2
  exit 1
fi

backup_real=$(realpath -e -- "$backup_dir")
case "$backup_real" in
  "$backup_root"/backup-*) ;;
  *) echo 'Kopia musi znajdować się w bezpiecznym katalogu backupów.' >&2; exit 1 ;;
esac

(
  cd "$backup_real"
  sha256sum --quiet --check SHA256SUMS
)

scratch="roversense_restore_check_$$"
restoring=0
cleanup() {
  if (( restoring )); then
    psql -X -v ON_ERROR_STOP=1 -d "$scratch" \
      -c 'SELECT timescaledb_post_restore();' >/dev/null 2>&1 || true
  fi
  dropdb --if-exists --force "$scratch" >/dev/null 2>&1 || true
}
trap cleanup EXIT

createdb --template=template0 "$scratch"
psql -X -v ON_ERROR_STOP=1 -d "$scratch" \
  -c 'CREATE EXTENSION IF NOT EXISTS timescaledb;'
psql -X -v ON_ERROR_STOP=1 -d "$scratch" \
  -c 'SELECT timescaledb_pre_restore();'
restoring=1

# Bez równoległego -j: TimescaleDB wymaga odtworzenia katalogów w kolejności.
pg_restore --no-owner --no-acl --dbname="$scratch" \
  "$backup_real/roversense.dump"

psql -X -v ON_ERROR_STOP=1 -d "$scratch" \
  -c 'SELECT timescaledb_post_restore();'
restoring=0

count=$(psql -X -A -t -v ON_ERROR_STOP=1 -d "$scratch" \
  -c "SELECT count(*) FROM timescaledb_information.hypertables WHERE hypertable_name = 'measurements';")
if [[ "$count" != 1 ]]; then
  echo 'Odtworzona baza nie ma hypertable measurements.' >&2
  exit 1
fi

echo 'Testowe odtworzenie bazy zakończone powodzeniem.'
