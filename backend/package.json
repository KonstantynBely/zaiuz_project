{
  "name": "roversense-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test ../tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test ../tests/integration/*.test.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed-admin": "tsx src/database/seed-admin.ts"
  },
  "dependencies": { "fastify": "^5.6.0", "pg": "^8.16.0", "bcryptjs": "^3.0.2" },
  "devDependencies": {
    "@types/node": "^24.0.0", "@types/pg": "^8.15.0",
    "tsx": "^4.20.0", "typescript": "^5.9.0"
  }
}
